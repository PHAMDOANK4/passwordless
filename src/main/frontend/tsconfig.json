{
    "compilerOptions": {
        "module": "esnext",
        "esModuleInterop": true,
        "target": "es2020",
        "moduleResolution": "node",
        "sourceMap": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["node"]
    },
    "exclude": [
        "node_modules",
        "dist",
    ],
    "include": [
        "src",
        "./src/**/*"
    ],
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
}